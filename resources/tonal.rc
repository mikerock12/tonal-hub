#pragma code_page(65001)
#include <winver.h>

// Ícone do Tonal (gerado por make-icon.ps1). O Qt usa o IDI_ICON1 como ícone padrão das janelas no Windows.
IDI_ICON1 ICON "tonal.ico"

// Nome e versão do executável: aparecem no painel de mídia do Windows, no Gerenciador de Tarefas e nas
// Propriedades do arquivo. Os números vêm do project() do CMakeLists.txt.
VS_VERSION_INFO VERSIONINFO
FILEVERSION     TONAL_VERSION_MAJOR, TONAL_VERSION_MINOR, TONAL_VERSION_PATCH, 0
PRODUCTVERSION  TONAL_VERSION_MAJOR, TONAL_VERSION_MINOR, TONAL_VERSION_PATCH, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604B0" // português (Brasil), Unicode
        BEGIN
            VALUE "CompanyName", "Tonal"
            VALUE "FileDescription", "Tonal"
            VALUE "FileVersion", PROJECT_VERSION_STRING
            VALUE "InternalName", "Tonal"
            VALUE "LegalCopyright", "Copyright (c) 2026 Natheus. Licença MIT."
            VALUE "OriginalFilename", "Tonal.exe"
            VALUE "ProductName", "Tonal"
            VALUE "ProductVersion", PROJECT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
