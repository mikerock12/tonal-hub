<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:theme="@android:style/Theme.Material.NoActionBar" android:label="Tonal Hub"
        android:icon="@drawable/ic_tonal" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true" android:usesCleartextTraffic="false">
        <activity android:name=".HubActivity" android:process=":hub" android:exported="true" />
        <!-- Tonalify and IndieTonal run in their own tasks: switching the launcher alias
         (theme icon) only removes the Hub task, never the player the listener is using. -->
    <!-- Launcher icon follows the theme: one alias per theme, only the chosen one enabled (AppTheme.applyLauncherIcon). -->
        <activity-alias android:name=".HubIconTonal" android:targetActivity=".HubActivity" android:icon="@drawable/ic_tonal" android:exported="true" android:enabled="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".HubIconAurora" android:targetActivity=".HubActivity" android:icon="@drawable/ic_tonal_aurora" android:exported="true" android:enabled="false">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".HubIconSolar" android:targetActivity=".HubActivity" android:icon="@drawable/ic_tonal_solar" android:exported="true" android:enabled="false">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".HubIconNeon" android:targetActivity=".HubActivity" android:icon="@drawable/ic_tonal_neon" android:exported="true" android:enabled="false">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".HubIconOceano" android:targetActivity=".HubActivity" android:icon="@drawable/ic_tonal_oceano" android:exported="true" android:enabled="false">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".HubIconGrafite" android:targetActivity=".HubActivity" android:icon="@drawable/ic_tonal_grafite" android:exported="true" android:enabled="false">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity android:name=".MainActivity" android:label="Tonalify" android:exported="true" android:launchMode="singleTop" android:taskAffinity="${applicationId}.tonalify" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".IndieActivity" android:label="IndieTonal" android:process=":indie" android:exported="false" android:launchMode="singleTop" android:taskAffinity="${applicationId}.indie" android:configChanges="orientation|screenSize|keyboardHidden" />
        <provider android:name=".ShareCardProvider" android:authorities="${applicationId}.sharecard" android:exported="false" android:grantUriPermissions="true" />
        <service android:name=".PlaybackService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <service android:name=".IndiePlaybackService" android:process=":indie" android:exported="false" android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
